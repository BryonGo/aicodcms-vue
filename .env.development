# 本地环境
ENV = 'development'

# 本地环境接口地址：走 vite 的 /api 代理（同源），别写远端绝对地址
# —— 绝对地址会让浏览器把登录等写请求当**跨站**，被后端 CSRF 中间件 403。
# 代理目标默认 https://api.thdmid.com，可用 VITE_DEV_API_TARGET 覆盖（如本地 API）。
VITE_API_URL = '/'

# 代理目标：**本地 dev 走本地起的那份 API**（ipv4 直连，避开 localhost 的 v6 解析），
# 也就是 /tmp/aicodcms-dev-latest（配置 manifest/config/config.local.yaml -> 库 aicodcms_dev，
# 经 ssh 隧道的 3306）。想改回远端 dev API 时：VITE_DEV_API_TARGET=https://api.thdmid.com vp dev
VITE_DEV_API_TARGET = 'http://127.0.0.1:8201'
