# port 端口号
VITE_PORT = 8888

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN = true
VUE_APP_LOG_LEVEL=debug

# public path 配置线上环境路径（打包）、本地通过 http-server 访问时，请置空即可
VITE_PUBLIC_PATH = /vue-next-admin-preview/

# 全局调试开关（true=开启API日志，false=关闭）
VITE_APP_DEBUG = true

# 版权信息（build 前可修改；默认 aicodcms）
VITE_APP_COPYRIGHT_OWNER = 桃花岛
VITE_APP_COPYRIGHT_YEAR = 2021-2026

# 网站标题（侧边栏 logo / 浏览器 title；build 前可修改；默认 AICODCMS）
VITE_APP_TITLE = TaoHuaDao Console

# 登录页 H1 副标题（默认跟随 VITE_APP_TITLE，可单独设置；如不需要可留空）
VITE_APP_VICE_TITLE =